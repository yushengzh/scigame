          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note16" value="根据反馈修订假设并重复，直到允许提交 final 或达到 max_turns" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="330" y="950" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m17" value="next_action(updated EpisodeView)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.7368;entryX=0;entryY=0.0;" edge="1" parent="1" source="act9" target="act6">
          <mxGeometry relative="1" as="geometry" />
