        <mxCell id="m1" value="run_episode(player, case)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1087;entryX=0;entryY=0.0;" edge="1" parent="1" source="caller" target="act9">
