        <mxCell id="m7" value="PlayerAction(experiment + portfolio)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.2632;" edge="1" parent="1" source="act2" target="act9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="apply(action)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.307;entryX=0;entryY=0.0;" edge="1" parent="1" source="act9" target="act5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m9" value="respond(proposal)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1316;entryX=0;entryY=0.0;" edge="1" parent="1" source="act5" target="act4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m10" value="按公开资源校验" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1786;entryX=1;entryY=0.2857;" edge="1" parent="1" source="act4" target="act4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1030" y="640" /><mxPoint x="1030" y="670" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note11" value="非法设置直接反馈；仅 NEEDS_CLARIFICATION 不消耗预算" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="990" y="690" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m12" value="run(valid proposal)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.6429;entryX=0;entryY=0.0;" edge="1" parent="1" source="act4" target="act3">
          <mxGeometry relative="1" as="geometry" />
