          <mxGeometry x="1360" y="40" width="100" height="1380" as="geometry" />
        </mxCell>
        <mxCell id="act0" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="case_oracle">
          <mxGeometry x="65" y="250" width="10" height="50" as="geometry" />
        </mxCell>
        <mxCell id="act1" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="episode">
          <mxGeometry x="45" y="200" width="10" height="150" as="geometry" />
