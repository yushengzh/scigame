        <mxCell id="m6" value="next_action(EpisodeView)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.2193;entryX=0;entryY=0.0;" edge="1" parent="1" source="act9" target="act2">
          <mxGeometry relative="1" as="geometry" />
