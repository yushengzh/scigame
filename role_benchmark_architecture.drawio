          <mxGeometry x="45" y="150" width="10" height="1140" as="geometry" />
        </mxCell>
        <mxCell id="note0" value="BenchmarkCase = 公开 CaseDefinition + 私有 WorldModel + 私有 Evaluator" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
