        <mxCell id="m2" value="Episode(case, LLMOracle(...))" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0505;entryX=0;entryY=0.0;" edge="1" parent="1" source="act7" target="act3">
