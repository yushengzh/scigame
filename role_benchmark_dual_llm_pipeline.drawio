          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m9" value="Oracle LLM emits {message} only" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.6818;entryX=1;entryY=0.8182;" edge="1" parent="1" source="act2" target="act2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1150" y="590"/><mxPoint x="1150" y="620"/></Array>
