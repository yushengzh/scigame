        <mxCell id="note0" value="Build BenchmarkCase: public definition + private WorldModel + private evaluator" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="110" y="110" width="190" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="run_llm_episode(case, player backend, oracle backend)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1271;entryX=0;entryY=0.0;" edge="1" parent="1" source="factory" target="act7">
